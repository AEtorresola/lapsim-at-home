QBZ9                     =  0                       $Slope factor Br of residual torque Mzr
QBZ10                    =  0.000947378             $Slope factor Br of residual torque Mzr
QCZ1                     =  1.06006                 $Shape factor Cpt for pneumatic trail
QDZ1                     =  0.151684                $Peak trail Dpt" = Dpt*(Fz/Fznom*R0)
QDZ2                     =  0.0125193               $Variation of peak Dpt with load
