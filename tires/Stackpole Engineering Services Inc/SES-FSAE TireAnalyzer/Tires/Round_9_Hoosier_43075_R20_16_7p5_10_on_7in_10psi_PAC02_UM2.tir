QDZ7                     =  0.0305341               $Variation of peak factor Dmr with load
QDZ8                     = -3.61442                 $Variation of peak factor Dmr with camber
QDZ9                     =  1.82827                 $Variation of peak factor Dmr with camber and load
QEZ1                     = -1.68785                 $Trail curvature Ept at Fznom
QEZ2                     =  0.327677                $Variation of curvature Ept with load
QEZ3                     = -0.417796                $Variation of curvature Ept with load squared
QEZ4                     =  0.315828                $Variation of curvature Ept with sign of Alpha-t
QEZ5                     =  0                       $Variation of Ept with camber and sign Alpha-t
QHZ1                     = -0.00604034              $Trail horizontal shift Sht at Fznom
QHZ2                     = -0.000431869             $Variation of shift Sht with load
QHZ3                     =  0.0730333               $Variation of shift Sht with camber
QHZ4                     = -0.231743                $Variation of shift Sht with camber and load
SSZ1                     =  0                       $Nominal value of s/R0: effect of Fx on Mz
SSZ2                     =  0                       $Variation of distance s/R0 with Fy/Fznom
SSZ3                     =  0                       $Variation of distance s/R0 with camber
SSZ4                     =  0                       $Variation of distance s/R0 with load and camber
QPZ1                     =  0                       $Variation of peak Dt with pressure
QPZ2                     =  0                       $Variation of peak Dr with pressure
QTZ1                     =  0                       $Gyration torque constant
MBELT                    =  0                       $Belt mass of the wheel
$-----------------------------------------------------------------LOADED_RADIUS
[LOADED_RADIUS_COEFFICIENTS]
QRE0                     =  1.002                   $Correction factor for measured unloaded radius
QV1                      =  0.001                   $Tyre radius growth coefficient
QV2                      =  0                       $Tyre stiffness variation coefficient with speed
QFCX1                    =  0                       $Tyre stiffness interaction with Fx
QFCY1                    =  0                       $Tyre stiffness interaction with Fy
QFCG1                    =  0                       $Tyre stiffness interaction with camber squared
QFZ1                     =  21                      $Linear stiffness coefficient, if zero, VERTICAL_STIFFNESS is taken
QFZ2                     =  91                      $Tyre vertical stiffness coefficient (quadratic)
QFZ3                     =  0                       $Camber dependency of the tyre vertical stiffness
QPFZ1                    =  0                       $Tyre stiffness variation with pressure
